<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 추적하지 않는다. 광고 식별자를 쓰지 않고, 다른 회사의 데이터와
	     연결하지도 않는다. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- 애플이 사용 사유를 요구하는 API(UserDefaults, 파일 타임스탬프,
	     디스크 여유 공간, 시스템 부팅 시각, 활성 키보드)를 쓰지 않는다.
	     Firebase 등 SDK 가 쓰는 것은 각 SDK 가 자체 매니페스트로 선언한다. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>

	<!-- 사용자가 즐겨찾기에 추가한 지역의 좌표를 우리 서버
	     (nearestStation)로 보내 최근접 측정소를 찾는다.
	     기기 GPS 가 아니라 사용자가 검색해 고른 도시의 좌표라
	     정밀 위치가 아닌 대략적 위치로 신고한다.

	     조회에 실패하거나 주변 30km 안에 측정소가 없을 때 서버가
	     좌표를 에러 로그에 남긴다(Cloud Logging, 기본 30일 보관).
	     요청 처리 후 즉시 폐기되지 않으므로 "수집"으로 신고한다.

	     계정이나 식별자가 없어 사용자와 연결되지 않고(Linked = false),
	     추적에도 쓰지 않는다(Tracking = false). -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
